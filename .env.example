# Sprites API token (https://sprites.dev → Tokens, or `sprite login`). Server-side only.
SPRITES_TOKEN=
# Optional: override the Sprites API base URL.
# SPRITES_API_URL=https://api.sprites.dev

# GitHub connector id. Find it with `npm run connector -- list` (first column).
SHIPFIG_GITHUB_CONNECTION_ID=
# Name of the trusted sprite that makes connector gateway calls. Must match the
# connector policy name_prefix (`npm run connector -- apply-policy`).
SHIPFIG_GATEWAY_SPRITE=shipfig-gateway

# Optional comma-separated allowlist of owner/repo the app may operate on.
# Leave empty to allow any repository the connector can see.
SHIPFIG_ALLOWED_REPOS=

# OpenAI API key for planning, editing and review (Responses API). Server-side
# only; never sent to any sprite.
OPENAI_API_KEY=
# Optional: model used by the agent.
# SHIPFIG_OPENAI_MODEL=gpt-5.5
