# Sprites API token (https://sprites.dev → Tokens, or `sprite login`). Server-side only.
SPRITES_TOKEN=
# Optional: override the Sprites API base URL.
# SPRITES_API_URL=https://api.sprites.dev

# GitHub connector id. Find it with `npm run connector -- list` (first column).
SHIPFIG_GITHUB_CONNECTION_ID=
# Name of the trusted sprite that makes connector gateway calls. Must match the
# connector policy name_prefix (`npm run connector -- apply-policy`).
SHIPFIG_GATEWAY_SPRITE=shipfig-gateway

# Optional comma-separated allowlist of owner/repo the app may operate on.
# Leave empty to allow any repository the connector can see.
SHIPFIG_ALLOWED_REPOS=

# Model provider for planning, editing and review: openai (default) or anthropic.
# Keys are server-side only and never sent to any sprite.
# SHIPFIG_AGENT_PROVIDER=openai

# OpenAI (Responses API). Required when the provider is openai.
OPENAI_API_KEY=
# SHIPFIG_OPENAI_MODEL=gpt-6.2-sol

# Anthropic / Claude (Messages API). If unset, the SDK also accepts
# ANTHROPIC_AUTH_TOKEN or a profile from `ant auth login`.
# ANTHROPIC_API_KEY=
# SHIPFIG_ANTHROPIC_MODEL=claude-opus-5-5
# SHIPFIG_ANTHROPIC_EFFORT=high

# Postgres connection string used by Drizzle ORM and Better Auth.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shipfig

# Better Auth secret (at least 32 random bytes, e.g. `openssl rand -base64 32`)
# and canonical application URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional GitHub OAuth / GitHub App credentials for "Continue with GitHub" & account linking.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional GitHub App URL slug (e.g. `shipfig` from https://github.com/apps/shipfig)
# to link directly to GitHub's per-repository installation picker from Settings.
# GITHUB_APP_SLUG=

# Optional operator token (at least 16 characters) for headless/CLI Bearer or Basic auth.
# SHIPFIG_OPERATOR_TOKEN=
